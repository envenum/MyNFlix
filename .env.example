# URL of your deployed Google Apps Script web app (ends with /exec).
# For local dev: copy this file to .env.local and fill it in.
# For GitHub Pages: add it as a repository *variable* named DRIVE_API_URL
# (Settings > Secrets and variables > Actions > Variables).
VITE_DRIVE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
